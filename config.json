{
  "schema_version": 1,
  "mode": "Auto",
  "camera": {
    "index": 0,
    "fps_limit": 30,
    "width": 1280,
    "height": 720
  },
  "preview": {
    "enabled": true,
    "landmarks": true
  },
  "feedback": {
    "enabled": true
  },
  "thresholds": {
    "gesture_hold_ms": 700,
    "action_cooldown_ms": 2000,
    "motion_cooldown_ms": 1500,
    "max_tracking_gap_ms": 250,
    "max_event_age_ms": 250,
    "min_confidence": 0.7,
    "swipe_distance": 0.25,
    "swipe_max_duration_ms": 700
  },
  "safety": {
    "paused": true,
    "enabled": true,
    "sleep_computer": true,
    "confirmed_destructive": []
  },
  "allowed_actions": [],
  "bindings": {},
  "targets": {
    "applications": {},
    "urls": {
      "browser.open_url": "https://www.youtube.com"
    },
    "shortcuts": {
      "browser.new_tab": "ctrl+t",
      "browser.refresh_page": "ctrl+r",
      "browser.go_back": "alt+left",
      "browser.previous_tab": "ctrl+shift+tab",
      "browser.next_tab": "ctrl+tab",
      "media.volume_up": "volume_up",
      "media.next_track": "media_next_track",
      "presentation.next_slide": "right"
    }
  },
  "execution": {
    "dry_run": false
  },
  "profiles": {
    "Teams": {
      "FIST": "teams.toggle_mute",
      "POINTING_UP": "teams.toggle_raise_hand",
      "PINCH": "teams.toggle_camera"
    },
    "Browser": {
      "FIST": "browser.new_tab",
      "THUMBS_UP": "browser.open_url",
      "SWIPE_LEFT": "browser.previous_tab",
      "SWIPE_RIGHT": "browser.next_tab",
      "POINTING_UP": "browser.go_back",
      "OPEN_PALM": "browser.open_url",
      "THUMBS_DOWN": "none",
      "VICTORY": "none",
      "PINCH": "none",
      "ROCK": "none",
      "SWIPE_UP": "none",
      "SWIPE_DOWN": "none"
    },
    "Presentation": {
      "SWIPE_RIGHT": "presentation.next_slide",
      "SWIPE_LEFT": "presentation.previous_slide",
      "THUMBS_UP": "presentation.start_presentation",
      "FIST": "presentation.end_presentation"
    },
    "Media": {
      "FIST": "media.play_pause",
      "POINTING_UP": "media.stop",
      "THUMBS_UP": "media.volume_up",
      "THUMBS_DOWN": "media.volume_down",
      "SWIPE_RIGHT": "media.next_track",
      "SWIPE_LEFT": "media.previous_track"
    },
    "System": {
      "FIST": "system.toggle_mute",
      "PINCH": "system.take_screenshot",
      "SWIPE_LEFT": "system.switch_virtual_desktop",
      "SWIPE_RIGHT": "system.switch_virtual_desktop"
    }
  }
}
